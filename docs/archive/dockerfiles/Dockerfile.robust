# ROBUST DOCKERFILE FOR ALGORHYTHM SERVICE
# Multi-stage build with explicit verification steps

# Stage 1: Build stage
FROM node:20-alpine AS builder

# Set working directory
WORKDIR /usr/src/app

# Copy package files first for better caching
COPY package*.json ./
COPY tsconfig.json ./
COPY nest-cli.json ./

# Install dependencies with verbose output
RUN echo "📦 Installing dependencies..." && \
    npm install --legacy-peer-deps --verbose && \
    echo "✅ Dependencies installed"

# Copy source code
COPY . .

# Build the application with explicit verification
RUN echo "🔨 Building TypeScript application..." && \
    npm run build && \
    echo "✅ Build completed"

# Verify build output exists and is valid
RUN echo "🔍 Verifying build output..." && \
    ls -la dist/ && \
    test -f dist/main.js || (echo "❌ dist/main.js not found after build!" && exit 1) && \
    test -s dist/main.js || (echo "❌ dist/main.js is empty!" && exit 1) && \
    echo "✅ dist/main.js exists and is not empty"

# Test that the built application can be loaded
RUN echo "🧪 Testing built application..." && \
    node -e "console.log('Testing main.js import...'); require('./dist/main.js'); console.log('✅ main.js loads successfully')" && \
    echo "✅ Application loads successfully"

# Stage 2: Production stage
FROM node:20-alpine AS production

# Set working directory
WORKDIR /usr/src/app

# Copy only production dependencies
COPY package*.json ./
RUN npm ci --only=production --legacy-peer-deps && \
    npm cache clean --force

# Copy built application from builder stage
COPY --from=builder /usr/src/app/dist ./dist

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S algorhythm -u 1001 && \
    chown -R algorhythm:nodejs /usr/src/app

USER algorhythm

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:8080/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) })"

# Final verification before starting
RUN echo "🔍 Final verification..." && \
    test -f dist/main.js || (echo "❌ dist/main.js not found in production stage!" && exit 1) && \
    test -s dist/main.js || (echo "❌ dist/main.js is empty in production stage!" && exit 1) && \
    echo "✅ Production stage ready"

# Start the application
CMD ["node", "dist/main.js"]
