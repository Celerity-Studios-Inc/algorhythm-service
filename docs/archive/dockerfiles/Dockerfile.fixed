# FIXED DOCKERFILE FOR ALGORHYTHM SERVICE
# Single-stage build with comprehensive verification

FROM node:20-alpine

# Set working directory
WORKDIR /usr/src/app

# Copy package files first for better caching
COPY package*.json ./
COPY tsconfig.json ./
COPY nest-cli.json ./

# Install ALL dependencies (including devDependencies for build)
RUN echo "📦 Installing dependencies..." && \
    npm install --legacy-peer-deps && \
    echo "✅ Dependencies installed"

# Copy source code
COPY . .

# Build the application with comprehensive verification
RUN echo "🔨 Building TypeScript application..." && \
    npm run build && \
    echo "✅ Build completed"

# Comprehensive verification of build output
RUN echo "🔍 Verifying build output..." && \
    echo "📁 Contents of dist directory:" && \
    ls -la dist/ && \
    echo "📄 Checking main.js file:" && \
    test -f dist/main.js || (echo "❌ dist/main.js not found after build!" && exit 1) && \
    test -s dist/main.js || (echo "❌ dist/main.js is empty!" && exit 1) && \
    echo "📊 File size:" && \
    wc -c dist/main.js && \
    echo "✅ dist/main.js exists and is not empty"

# Test that the built application can be loaded
RUN echo "🧪 Testing built application..." && \
    node -e "console.log('Testing main.js import...'); try { require('./dist/main.js'); console.log('✅ main.js loads successfully'); } catch(e) { console.error('❌ Error loading main.js:', e.message); process.exit(1); }" && \
    echo "✅ Application loads successfully"

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S algorhythm -u 1001 && \
    chown -R algorhythm:nodejs /usr/src/app

USER algorhythm

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:8080/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) })"

# Final verification before starting
RUN echo "🔍 Final verification before start..." && \
    test -f dist/main.js || (echo "❌ dist/main.js not found in final stage!" && exit 1) && \
    test -s dist/main.js || (echo "❌ dist/main.js is empty in final stage!" && exit 1) && \
    echo "✅ Final stage ready"

# Start the application
CMD ["node", "dist/main.js"]