# WORKING DOCKERIGNORE FOR ALGORHYTHM SERVICE
# This ensures all necessary files are included in the Docker build

# Exclude node_modules (will be installed fresh)
node_modules
npm-debug.log*

# Exclude development files
.git
.gitignore
README.md
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Exclude test files
test
tests
*.test.js
*.test.ts
*.spec.js
*.spec.ts

# Exclude documentation
docs
*.md

# Exclude CI/CD files
.github
.gitlab-ci.yml
.travis.yml

# Exclude IDE files
.vscode
.idea
*.swp
*.swo

# Exclude OS files
.DS_Store
Thumbs.db

# Exclude logs
logs
*.log

# Exclude temporary files
tmp
temp

# IMPORTANT: DO NOT exclude dist folder - it's needed for the application to run
# The dist folder contains the compiled TypeScript code that the application needs
