# SIMPLE DOCKERFILE FOR ALGORHYTHM SERVICE
# Single-stage build to ensure dist/main.js is created

FROM node:20-alpine

# Set working directory
WORKDIR /usr/src/app

# Copy package files first for better caching
COPY package*.json ./
COPY tsconfig.json ./
COPY nest-cli.json ./

# Install ALL dependencies (including devDependencies for build)
RUN npm install --legacy-peer-deps

# Copy source code
COPY . .

# 🔧 CRITICAL: Build the application
RUN echo "🔨 Building TypeScript..." && \
    npm run build && \
    echo "✅ Build completed"

# 🔧 CRITICAL: Verify dist/main.js exists
RUN echo "🔍 Verifying build output..." && \
    ls -la dist/ && \
    test -f dist/main.js || (echo "❌ dist/main.js not found after build!" && exit 1) && \
    echo "✅ dist/main.js exists"

# Create non-root user
RUN addgroup -g 1001 -S nodejs && adduser -S algorhythm -u 1001
RUN chown -R algorhythm:nodejs /usr/src/app
USER algorhythm

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:8080/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) })"

# Start the application
CMD ["node", "dist/main.js"]
